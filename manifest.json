{
  "manifest_version": 3,
  "name": "Pazaryeri Kâr Hesaplayıcı",
  "version": "2.3.7",
  "description": "Trendyol ve Hepsiburada ürün sayfalarında platforma özel kargo, KDV, komisyon, stopaj ve kâr hesaplama.",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": [
        "https://www.trendyol.com/*-p-*",
        "https://www.hepsiburada.com/*-p-*",
        "https://www.hepsiburada.com/*-pm-*"
      ],
      "js": ["seller-history.js", "storage.js", "shipping-rates.js", "hepsiburada-rates.js", "calculator.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
